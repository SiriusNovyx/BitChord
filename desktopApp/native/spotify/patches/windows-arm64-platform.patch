+#[cfg(all(test, target_os = "windows"))]
+mod bitchord_platform_tests {
+    use super::*;
+    #[tokio::test]
+    async fn native_desktop_platform_tag() {
+        let mut transport = Vec::new();
+        let packet = client_hello(&mut transport, vec![1]).await.unwrap();
+        let hello = ClientHello::parse_from_bytes(&packet[6..]).unwrap();
+        let expected = if cfg!(target_arch = "x86") { Platform::PLATFORM_WIN32_X86 }
+            else { Platform::PLATFORM_WIN32_X86_64 };
+        assert_eq!(hello.build_info.as_ref().unwrap().platform(), expected);
+        assert_eq!(transport, packet);
+    }
+}
